{
  "name": "gentle-accounts",
  "version": "0.1.0",
  "description": "Multiple accounts for gentle-shell and pi: switch between Claude (claude-bridge), Codex and Anthropic logins with /gentle:accounts, or start a shell with a given profile.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "gentle-shell",
    "gentle-shell-package",
    "gentle-shell-extension",
    "claude-bridge",
    "codex",
    "profiles",
    "accounts"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "gentle-accounts": "./bin/gentle-accounts.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test --test-timeout=120000 \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/render-assets.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "author": "Federico",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcireza/gentle-accounts.git"
  },
  "homepage": "https://github.com/fcireza/gentle-accounts#readme",
  "bugs": {
    "url": "https://github.com/fcireza/gentle-accounts/issues"
  }
}
